//
// Manuscript
//
// Export style directed towards authors of manuscripts
//
// Visit http://www.parrot.app/styles
// for full reference
//


//
// Document & Layout Settings
//

document-settings {
	page-inset-top:		30mm;	page-inset-inner:	30mm
	page-inset-bottom:	30mm;	page-inset-outer:	30mm

	section-break:			paragraph-divider
	// Continue on a new page after dividers

	two-sided:				no
	page-binding:			left

	footnote-enumeration:	per-section
	footnote-placement:		end-of-page
	footnote-style:			decimal
}



//
// Variables
//



//
// Default Typography
//

defaults {
	font-family:			"Courier New"
	font-weight:			normal
	font-size:				12pt
	line-height:			28pt

	orphans-and-widows:		prevented

	text-alignment:			left
	hyphenation:			no
}



//
// Basic Non-Text-Area Page Layout
//

area-footnotes {
	font-size:				8pt
	line-height:			12pt

	top-spacing:			3mm
	margin-right:			75mm

	divider-length:			85mm
	divider-width:			0.3pt
}

area-footer {
	content:				page-number
	text-alignment:			right
	top-spacing:			3mm
	bottom-spacing:			10mm
	font-size:				10pt
}

@code {
	font-weight:			normal
	font-slant:				normal
	// Reset all traits to normal, since this can appear anywhere
}



//
// Headers
//

heading-all {
	font-style:				"Bold"
	keep-with-following:	true
	text-alignment:			center
}

heading-1 {
	margin-bottom:			7mm

	page-break:				before
}

heading-2 {
	margin-top:				7mm
	margin-bottom:			7mm
}

heading-3 {
	margin-top:				7mm
	margin-bottom:			7mm
}

heading-4 {
	margin-top:				7mm
	margin-bottom:			4.5mm
}

heading-5 {
	margin-top:				7mm
	margin-bottom:			4.5mm
}

heading-6 {
	margin-top:				3mm
	margin-bottom:			4mm
}



//
// Paragraph styles
//

paragraph {
	first-line-indent:		13mm
	margin-top:				1mm
	hyphenation:			no
}

paragraph:first {
	margin-top:				0mm
}

paragraph-divider {
	content:				"#"
	text-alignment:			center
	visibility:				visible
}



//
// Tables styles
//

table {
	border-top-style:		solid
	border-top-width:		2pt
	border-bottom-style:	solid
	border-bottom-width:	2pt
}

table-cell {
	padding-bottom:			8pt

	line-height:			20pt
}

table-cell :header {
	font-weight:			bold

	row-separator-style:	solid
	row-separator-width:	0.5pt
}

table-cell :header-row-boundary {
	row-separator-style:	solid
	row-separator-width:	0.5pt
}



//
// Images
//

paragraph-figure {
	margin-top:				13mm
	margin-bottom:			10mm
}

figure-caption {
	font-slant:				italic
	line-height:			28pt
	margin-left:			13mm
	margin-right:			13mm
}



//
// Block styles
//

block-code : @code {
	first-line-indent:		-4em
	line-height:			120%
	font-color:				#000000
	margin-left:			4em
	margin-bottom:			6mm
	margin-top:				6mm
}

block-code paragraph{
	margin-top:				0pt
	margin-bottom:			0pt
	hyphenation:			no
	default-tab-interval:	4em
}

block-quote {
	margin-top:				5mm
	margin-bottom:			5mm
	margin-left:			13mm
}

block-quote paragraph{
	first-line-indent:		0pt

	hyphenation:			no
}

block-raw {
	visibility:				hidden
	// kills raw source blocks
}

block-comment {
	visibility:				visible

	margin-top:				0pt
	margin-left:			13mm
}



//
// List styles
//

list-all {
	margin-left:			7mm
	margin-top:				4.5mm
	margin-bottom:			7mm
}

list-all paragraph {
	margin-top:				1mm
	margin-bottom:			1mm
}

list-all list-all {
	margin-top:				0pt
	margin-bottom:			0pt
	// No extra spacings between nested ordered and unordered lists
}

list-ordered {
	enumeration-format:		"%d."
	text-inset:				2em
	// Simulates tab stop justified right
}

list-ordered list-ordered {
	enumeration-format:		"%*%d"
	text-inset:				4em
	// Simulates tab stop justified right
}

list-ordered list-ordered list-ordered {
	enumeration-format:		"%*.%d"
	text-inset:				6em
	// Simulates tab stop justified right
}

list-unordered {
	enumeration-format:		"-"
	text-inset:				2em
	// Simulates tab stop justified right
}

list-unordered list-unordered {
	enumeration-format:		"*"
	text-inset:				4em
	// Simulates tab stop justified right
}



//
// Table of contents styles
//

table-of-contents {
	trailing-column-fill: dense-dots
}

table-of-contents-item :heading-1 {
	font-weight: bold
}



//
// Inline styles
//

inline-strong {
	font-style:				"Bold"
}

inline-emphasis {
	font-slant:				italic
}

inline-mark {
	background-color:		#DDDDDD
}

inline-citation {
	font-slant:				italic
}

inline-code : @code {
	// Nothing else to set here, since it inherits from @code
}

inline-link {
	underline:				single
	font-weight:			bold
}

inline-comment {
	visibility:				hidden
	font-color:				#77787B
	background-color:		#E6E7E8
}

inline-annotation {
	background-color:		#dadada
}

inline-annotation:anchor {
	background-color:		#ffffff
}

inline-raw {
	visibility:				hidden
	// kills raw source
}

inline-delete {
	strikethrough:			single
	strikethrough-color:	#000000
}



//
// Parrot specific stuff
// By default, we are hiding tags (##) etc.
//

inline-comment parrot-tag {
	visibility:				visible
}

inline-comment inline-strong parrot-tag {
	visibility:				hidden
}

inline-comment inline-emphasis parrot-tag {
	visibility:				hidden
}

inline-comment inline-link parrot-tag {
	visibility:				hidden
}

inline-comment inline-annotation parrot-tag {
	visibility:				hidden
}

inline-comment inline-code parrot-tag {
	visibility:				hidden
}

inline-comment inline-delete parrot-tag {
	visibility:				hidden
}

inline-comment inline-mark parrot-tag {
	visibility:				hidden
}



//
// Syntax styles
//

syntax-all {
}

syntax-entity {
	font-color:				#7a7a7a
	font-weight:			bold
}

syntax-tag {
	font-color:				#000000
	font-weight:			bold
}

syntax-keyword {
	font-color:				#000000
	font-weight:			bold
	font-slant:				italic
}

syntax-parameter {
	font-color:				#777777
	font-weight:			bold
	font-slant:				italic
}

syntax-string {
	font-color:				#555555
	font-slant:				italic
}

syntax-constant {
	font-color:				#555555
	font-weight:			bold
	underline:				single
}

syntax-variable {
	font-color:				#555555
	font-weight:			bold
	underline:				single
	font-slant:				italic
}

syntax-escape {
	font-weight:			bold
	font-color:				#333333
}

syntax-comment {
	font-color:				#999999
}

syntax-error {
	font-color:				#999999
	font-weight:			bold
}



//
// Markup styles
//

syntax-heading {
	font-weight:			bold
	font-color:				#000000
	font-slant:				italic
}

syntax-italic {
	font-slant:				italic
	font-slant:				italic
}

syntax-bold {
	font-weight:			bold
	font-slant:				italic
}

syntax-deleted {
	font-color:				#999999
	font-slant:				italic
}

syntax-inserted {
	font-color:				#000000
	font-weight:			bold
	font-slant:				italic
}

syntax-changed {
	font-color:				#555555
	font-slant:				italic
}

syntax-link {
	underline:				single
	font-color:				#000000
	font-slant:				italic
}

syntax-list {
	font-color:				#000000
}